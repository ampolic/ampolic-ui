---
interface Props {
  name: string;
  id?: string;
  rows?: number;
  placeholder?: string;
  required?: boolean;
  class?: string;
}
const { class: className, ...attrs } = Astro.props;
const base = 'min-h-36 w-full rounded-(--radius-base) border border-line bg-surface p-4 shadow-card transition placeholder:text-text-muted/65 hover:border-brand/50 focus:border-brand focus:outline-none focus:ring-4 focus:ring-brand/10';
---
<textarea {...attrs} class:list={[base, className]}></textarea>
