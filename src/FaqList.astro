---
/* Card-style FAQ accordion, layout-shift-free:
   - Native <details name> groups items so ONE is open at a time (no JS).
   - Reserved answer height (--faq-answer-height): short answers leave
     whitespace, long ones scroll internally — the page below never moves.
   - Optional per-item icon (astro-icon name) in a brand-tinted circle; the
     open item gets a soft brand tint. No height:auto animation; polish =
     chevron 200ms, answer fade 200ms, hover 150ms, reduced-motion aware. */
import { Icon } from 'astro-icon/components';
interface Props {
  items: Array<{ question: string; Content: any; icon?: string }>;
  /** Accordion group name — must differ if two FaqLists share a page. */
  name?: string;
  /** Reserved answer height (any CSS length). Size to the largest answer. */
  answerHeight?: string;
  /** Index opened on load (keeps total height constant from first paint); null = all closed. */
  defaultOpen?: number | null;
}
const { items, name = 'faq', answerHeight = '10rem', defaultOpen = 0 } = Astro.props;
---

{/* Keep exactly one item open: closing the open item re-opens the first.
    Progressive enhancement — without JS the accordion is simply closable.
    Only active when an item is open by default (defaultOpen != null). */}
<script>
  document.querySelectorAll<HTMLElement>('[data-faq-keep-open]').forEach((group) => {
    // `toggle` doesn't bubble — listen in the capture phase on the container.
    group.addEventListener(
      'toggle',
      () => {
        // Let the browser finish the paired close/open of <details name> first.
        queueMicrotask(() => {
          const all = [...group.querySelectorAll('details')];
          if (!all.some((d) => d.open)) all[0] && (all[0].open = true);
        });
      },
      true
    );
  });
</script>

<div
  class="faq divide-line border-line bg-surface shadow-card divide-y overflow-hidden rounded-(--radius-base) border"
  style={`--faq-answer-height: ${answerHeight}`}
  data-faq-keep-open={defaultOpen !== null ? '' : undefined}
>
  {items.map((f, i) => (
    <details name={name} open={i === defaultOpen} class="group open:bg-brand/5 transition-colors duration-150">
      <summary class="flex min-h-11 cursor-pointer list-none items-center gap-4 px-5 py-4 font-medium transition-colors duration-150 hover:text-brand sm:px-6 [&::-webkit-details-marker]:hidden">
        {f.icon && (
          <span class="bg-brand/10 text-brand flex size-10 shrink-0 items-center justify-center rounded-full" aria-hidden="true">
            <Icon name={f.icon} class="size-5" />
          </span>
        )}
        <span class="flex-1">{f.question}</span>
        <svg
          class="faq-chevron size-4 shrink-0"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M3 6l5 5 5-5" />
        </svg>
      </summary>
      <div class:list={['faq-answer text-text-muted pr-5 pb-5 sm:pr-6', f.icon ? 'pl-[4.75rem] sm:pl-20' : 'pl-5 sm:pl-6']}>
        <f.Content />
      </div>
    </details>
  ))}
</div>

<style>
  .faq-chevron {
    transition: rotate 200ms ease;
  }
  details[open] .faq-chevron {
    rotate: 180deg;
  }
  /* Reserved space: every open answer occupies the same height; overflow
     scrolls internally instead of growing the page. */
  .faq-answer {
    height: var(--faq-answer-height);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  details[open] .faq-answer {
    animation: faq-fade 200ms ease;
  }
  @keyframes faq-fade {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-chevron {
      transition: none;
    }
    details[open] .faq-answer {
      animation: none;
    }
  }
</style>
