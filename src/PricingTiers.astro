---
/* Pricing tier cards: optional struck-through regular price next to the current
   price; the `featured` tier gets a brand border + label. Token-driven only. */
import Button from './Button.astro';
export interface Tier {
  name: string;
  price: string;
  regular?: string;
  period?: string;
  blurb?: string;
  features: string[];
  featured?: boolean;
}
interface Props {
  tiers: Tier[];
  ctaLabel: string;
  ctaHref: string;
  featuredLabel?: string;
}
const { tiers, ctaLabel, ctaHref, featuredLabel = 'Most popular' } = Astro.props;
---
<div class="grid gap-6 lg:grid-cols-3" data-stagger>
  {tiers.map((tier) => (
    <div
      class:list={[
        'flex h-full flex-col rounded-(--radius-base) border bg-surface p-7 shadow-card',
        tier.featured ? 'border-brand' : 'border-line',
      ]}
    >
      {tier.featured ? (
        <p class="font-mono text-xs uppercase tracking-[0.15em] text-brand">{featuredLabel}</p>
      ) : (
        <p class="font-mono text-xs uppercase tracking-[0.15em] text-text-muted" aria-hidden="true">&nbsp;</p>
      )}
      <h3 class="mt-3 font-display text-2xl font-semibold tracking-tight">{tier.name}</h3>
      <p class="mt-4 flex items-baseline gap-2">
        {tier.regular && (
          <s class="text-text-muted">
            <span class="sr-only">Regular price </span>{tier.regular}{tier.period}
          </s>
        )}
        <span class="font-display text-4xl font-semibold text-text">{tier.price}</span>
        {tier.period && <span class="text-text-muted">{tier.period}</span>}
      </p>
      {tier.blurb && <p class="mt-3 text-text-muted">{tier.blurb}</p>}
      <ul class="mt-6 flex-1 space-y-2 text-text-muted">
        {tier.features.map((f) => (
          <li class="flex gap-2"><span aria-hidden="true" class="text-brand">✓</span>{f}</li>
        ))}
      </ul>
      <div class="mt-8">
        <Button href={ctaHref} variant={tier.featured ? 'solid' : 'outline'}>{ctaLabel}</Button>
      </div>
    </div>
  ))}
</div>
