---
/* Component playground — `pnpm dev` and eyeball every exported component here.
   Not published; exists so changes can be reviewed visually before a release. */
import '../styles/global.css';
import {
  Button,
  Callout,
  Card,
  CtaBand,
  EmailLink,
  FaqList,
  FormInput,
  FormSelect,
  FormTextarea,
  Prose,
  SectionHeading,
  TestimonialCard,
  PricingTiers,
  PoweredByAmpolic,
  TeamMemberCard,
  WorkCard,
} from '../../src/index';
import FaqAnswer from '../components/FaqAnswer.astro';
import placeholder from '../assets/placeholder.svg';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ampolic/ui playground</title>
  </head>
  <body class="bg-surface text-text font-sans">
    <main class="mx-auto max-w-4xl space-y-16 px-4 py-16">
      <SectionHeading eyebrow="Playground" heading="@ampolic/ui" lede="Every exported component, rendered with placeholder tokens." />

      <section class="flex flex-wrap gap-4">
        <Button>Solid</Button>
        <Button variant="outline">Outline</Button>
        <Button variant="ghost">Ghost</Button>
        <Button href="#" variant="inverse">Inverse link</Button>
      </section>

      <Card>
        <p>A card with default padding and the shared surface treatment.</p>
      </Card>

      <Callout type="tip" title="Tip">Callouts render tip, note, and warning variants.</Callout>

      <TestimonialCard author="Jane Placeholder" role="Owner, Example Co." quote="Great work, fast turnaround." rating={5} />

      <FaqList
        items={[
          { question: 'What is this?', Content: FaqAnswer, icon: 'lucide:globe' },
          { question: 'Only one item opens at a time?', Content: FaqAnswer },
          { question: 'Does the page below ever move?', Content: FaqAnswer },
        ]}
      />

      <Prose>
        <h2>Prose block</h2>
        <p>Long-form typography defaults for markdown content.</p>
      </Prose>

      <p>Obfuscated email: <EmailLink email="hello@example.com" /></p>

      <form class="grid max-w-xl gap-4">
        <label class="grid gap-2 font-medium">Name <FormInput name="name" placeholder="Your name" /></label>
        <label class="grid gap-2 font-medium">Topic <FormSelect name="topic"><option>Select an option</option><option>General enquiry</option></FormSelect></label>
        <label class="grid gap-2 font-medium">Message <FormTextarea name="message" placeholder="Tell us how we can help." /></label>
      </form>

      <SectionHeading eyebrow="Display variant" heading="A larger heading with an optional accent rule" variant="display" rule />

      <PoweredByAmpolic />

      <PricingTiers
        ctaLabel="Get started"
        ctaHref="#"
        tiers={[
          { name: 'Starter', price: '$29', regular: '$59', period: '/mo', blurb: 'For new businesses.', features: ['One page', 'Hosting included'] },
          { name: 'Growth', price: '$79', period: '/mo', blurb: 'For growing teams.', features: ['Up to 10 pages', 'Ongoing SEO'], featured: true },
          { name: 'Custom', price: '$199+', period: '/mo', features: ['Everything in Growth', 'Custom workflows'] },
        ]}
      />

      <div class="grid gap-6 sm:grid-cols-2">
        <TeamMemberCard name="Jane Placeholder" role="Founder" bio="Short placeholder bio for the playground." photo={placeholder} linkLabel="Visit Website" linkHref="#" />
        <WorkCard name="Example Project" body="Short placeholder project description." url="#" image={placeholder} />
      </div>

      <CtaBand heading="Ready to start?" ctaLabel="Get a quote" ctaHref="#" />
    </main>
  </body>
</html>
